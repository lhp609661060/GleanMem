# gleanmem 配置（YDM_ 前缀，见 src/gleanmem/config.py）
# 复制为 .env 后填入真实值；.env 已被 gitignore，永远不要提交

YDM_DATABASE_URL=postgresql+asyncpg://ydm:ydm@localhost:5432/ydm

# LLM（LearningModel 的 llm 模式 + CodebaseAnalyzer 蒸馏）
# DeepSeek：base 固定如下，模型用 deepseek-chat
YDM_LLM_API_KEY=sk-your-key-here
YDM_LLM_API_BASE=https://api.deepseek.com/v1
YDM_LLM_MODEL=deepseek-chat

# 平台管理台 admin key（登录管理台用，可管理所有 Space；留空则禁用平台管理）
# 留空时 POST /api/v1/spaces 也会返 503——建 Space 需要先配置它
YDM_ADMIN_KEY=

# MCP SSE 鉴权：默认要求 X-Space-Key（与 REST 同一套强度）
# 仅内网演示/spike 可置 false 回退旧的「只信 X-Agent-ID」约定
YDM_MCP_AUTH_REQUIRED=true

# 浏览器跨域来源白名单（逗号分隔）；默认 * 便于本地前端开发，生产建议收紧
YDM_CORS_ORIGINS=*

# 单次 flush 取走的事件上限；事件重试达阈值后转死信（status=dead，留在库里不删）
YDM_FLUSH_BATCH_SIZE=50
YDM_EVENT_MAX_RETRIES=3

# 内置调度器（Space 级 cron，见 01-design §定时任务学习）
# 多副本部署时所有实例都可保持开启——由 agent_spaces.last_fired_slot 原子占槽选主
YDM_SCHEDULER_ENABLED=true
YDM_SCHEDULER_TICK_SECONDS=20
YDM_SCHEDULER_CATCHUP_WINDOW_MINUTES=720
